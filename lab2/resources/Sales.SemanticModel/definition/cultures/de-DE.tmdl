			table Customer
				caption: Kunde
				measure '# Customers'
					caption: Anzahl Kunden
					description: Anzahl der Kunden im aktuellen Filterkontext. Diese Kennzahl beschreibt den Kundenbestand, nicht nur Kunden mit einem Kauf.
				column CustomerKey
					caption: Kundenschlüssel
				column Gender
